
// 각자 입맛에 맞게 변경해서 사용하기.
### 회원가입
POST http://localhost:4000/api/auth/signup
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "12345678",
  "name": "테스터"
}

### 1. 먼저 로그인해서 토큰 받기
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "12345678"
}